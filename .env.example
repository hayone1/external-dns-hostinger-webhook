# Copy this file to .env and fill it in. .env is ignored by git.
#   cp .env.example .env

# Hostinger API token (hPanel > Profile > API). Give it an expiry date.
HOSTINGER_API_TOKEN=

# Webhook settings for `make run` and `make check-config`
DOMAIN_FILTER=example.com
LOG_LEVEL=debug

# End-to-end test in real mode (test/e2e/run.sh)
E2E_ZONE=example.com

# Remote k3s server for `make e2e-k3s` (test/e2e/k3s.sh): the SSH target,
# like user@host. Fill it in only in your own .env.
K3S_HOST=
