            "owner_id": {
              "type": "integer"
            },
            "tech_id": {
              "type": "integer"
            }
          },
          "type": "object"
        },
        "expires_at": {
          "format": "date-time",
          "nullable": true,
          "type": "string"
        },
        "is_lockable": {
          "type": "boolean"
