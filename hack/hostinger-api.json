    "Domains.V1.Domain.DomainResource": {
      "properties": {
        "created_at": {
          "format": "date-time",
          "type": "string"
        },
        "domain": {
          "nullable": true,
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "nullable": true,
          "type": "string"
