        "registered_at": {
          "format": "date-time",
          "nullable": true,
          "type": "string"
        },
        "status": {
          "enum": [
            "active",
            "pending_setup",
            "expired",
            "requested",
            "pending_verification",
            "deleted",
            "suspended",
            "failed"
          ],
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "type": "string"
        }
